# Salin menjadi .env.local lalu isi dengan nilai proyek Supabase (staging/produksi).
# JANGAN commit nilai asli. Anon key aman untuk browser, tetapi tetap simpan di
# pengaturan Cloudflare Pages, bukan di repo.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY
