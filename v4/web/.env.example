# Salin menjadi .env.local lalu isi dengan nilai proyek Supabase (staging/produksi).
# JANGAN commit nilai asli. Anon key aman untuk browser, tetapi tetap simpan di
# pengaturan Cloudflare Pages, bukan di repo.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# Opsional, hanya untuk keadaan darurat: buka file langsung lewat URL Google Drive
# (butuh akses Drive per pengguna). Bawaan: jembatan unduh aman.
# VITE_FILE_ACCESS_MODE=drive-url

# Variabel SERVER (Pages Functions) TIDAK memakai awalan VITE_ dan tidak boleh
# masuk bundel browser. Isi di Cloudflare Pages -> Settings -> Variables and
# Secrets (atau .dev.vars untuk `wrangler pages dev`, jangan di-commit):
#   SUPABASE_URL, SUPABASE_ANON_KEY, FILE_TICKET_SECRET (>= 32 karakter acak),
#   DRIVE_GATEWAY_URL, DRIVE_GATEWAY_SECRET
